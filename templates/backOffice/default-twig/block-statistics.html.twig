{# Statistics chart block — requires jqplot JS (block-statistics-js.html.twig) #}
{% if is_granted('VIEW', 'admin.order') %}
<div class="card mb-3 dashboard">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">{{ 'Dashboard'|trans({}, 'hookadminhome.bo.default') }}</h5>
        <div class="input-group" style="width: auto;">
            <span id="span-calendar" class="input-group-text">
                <i class="bi bi-calendar"></i>
            </span>
            <input type="text" class="form-control" id="date-picker">
            <button type="button" class="btn btn-secondary js-stats-refresh" data-month-offset="0">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="text-center mb-3">
            <div class="btn-group">
                <button type="button" class="btn btn-secondary active" data-toggle="jqplot" data-target="sales">
                    <i class="bi bi-currency-euro"></i> {{ 'Sales'|trans({}, 'hookadminhome.bo.default') }}
                </button>
                <button type="button" class="btn btn-primary" data-toggle="jqplot" data-target="registration">
                    <i class="bi bi-person"></i> {{ 'New customers'|trans({}, 'hookadminhome.bo.default') }}
                </button>
                <button type="button" class="btn btn-success" data-toggle="jqplot" data-target="orders">
                    <i class="bi bi-cart"></i> {{ 'Orders'|trans({}, 'hookadminhome.bo.default') }}
                </button>
                <button type="button" class="btn btn-info" data-toggle="jqplot" data-target="first-orders">
                    <i class="bi bi-hand-thumbs-up"></i> {{ 'First orders'|trans({}, 'hookadminhome.bo.default') }}
                </button>
                <button type="button" class="btn btn-danger" data-toggle="jqplot" data-target="aborted-orders">
                    <i class="bi bi-hand-thumbs-down"></i> {{ 'Aborted orders'|trans({}, 'hookadminhome.bo.default') }}
                </button>
            </div>
        </div>
        <hr/>
        <div class="jqplot-content">
            <div id="jqplot"></div>
        </div>
    </div>
</div>
{% endif %}
