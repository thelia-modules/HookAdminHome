{# Sales statistics block — data supplied by AdminHook::blockSalesStatistics #}
{% if is_granted('VIEW', 'admin.order') %}
<ul class="nav nav-tabs nav-fill mb-3" id="salesStatsTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="statjour-tab" data-bs-toggle="tab" data-bs-target="#statjour" type="button" role="tab">
            {{ 'Today'|trans({}, 'hookadminhome.bo.default') }}
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="statmois-tab" data-bs-toggle="tab" data-bs-target="#statmois" type="button" role="tab">
            {{ 'This month'|trans({}, 'hookadminhome.bo.default') }}
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="statannee-tab" data-bs-toggle="tab" data-bs-target="#statannee" type="button" role="tab">
            {{ 'This year'|trans({}, 'hookadminhome.bo.default') }}
        </button>
    </li>
</ul>

<div class="tab-content" id="salesStatsTabsContent">
    <div class="tab-pane fade show active" id="statjour" role="tabpanel">
        <div class="table-responsive">
            <table class="table table-striped">
                <tbody>
                <tr>
                    <th>{{ 'Overall sales'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_today.salesFormatted }}</td>
                </tr>
                <tr>
                    <th>{{ 'Sales excluding shipping'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_today.salesNoShippingFormatted }}</td>
                </tr>
                <tr>
                    <th>{{ 'Yesterday sales'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_yesterday.salesFormatted }}</td>
                </tr>
                <tr>
                    <th>{{ 'Orders'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_today.orderCount }}</td>
                </tr>
                <tr>
                    <th>{{ 'Average cart'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_today.averageCartFormatted }}</td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="tab-pane fade" id="statmois" role="tabpanel">
        <div class="table-responsive">
            <table class="table table-striped">
                <tbody>
                <tr>
                    <th>{{ 'Overall sales'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_month.salesFormatted }}</td>
                </tr>
                <tr>
                    <th>{{ 'Sales excluding shipping'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_month.salesNoShippingFormatted }}</td>
                </tr>
                <tr>
                    <th>{{ 'Previous month sales'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_prev_month.salesFormatted }}</td>
                </tr>
                <tr>
                    <th>{{ 'Orders'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_month.orderCount }}</td>
                </tr>
                <tr>
                    <th>{{ 'Average cart'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_month.averageCartFormatted }}</td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="tab-pane fade" id="statannee" role="tabpanel">
        <div class="table-responsive">
            <table class="table table-striped">
                <tbody>
                <tr>
                    <th>{{ 'Overall sales'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_year.salesFormatted }}</td>
                </tr>
                <tr>
                    <th>{{ 'Sales excluding shipping'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_year.salesNoShippingFormatted }}</td>
                </tr>
                <tr>
                    <th>{{ 'Previous year sales'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_prev_year.salesFormatted }}</td>
                </tr>
                <tr>
                    <th>{{ 'Orders'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_year.orderCount }}</td>
                </tr>
                <tr>
                    <th>{{ 'Average cart'|trans({}, 'hookadminhome.bo.default') }}</th>
                    <td>{{ stats_year.averageCartFormatted }}</td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endif %}
