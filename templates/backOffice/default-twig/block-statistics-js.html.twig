{# Statistics JS — jQuery+jqplot (no clean Stimulus port for jqplot), shipped with the module. #}
{# The default-twig BO ships no global jQuery, so the module carries the jqplot/moment stack itself. #}
<script src="{{ module_asset('HookAdminHome', 'assets/js/jquery.min.js') }}"></script>
<script src="{{ module_asset('HookAdminHome', 'assets/js/jquery.jqplot.min.js') }}"></script>
<script src="{{ module_asset('HookAdminHome', 'assets/js/jqplot.highlighter.min.js') }}"></script>
<script src="{{ module_asset('HookAdminHome', 'assets/js/jqplot.pointLabels.min.js') }}"></script>
<script src="{{ module_asset('HookAdminHome', 'assets/js/moment-with-locales.min.js') }}"></script>

<script>
(function () {
    var jQplotDate = moment();
    var $datePicker = document.getElementById('date-picker');
    var displayDateFormat = '{{ 'YYYY-MM'|trans({}, 'hookadminhome') }}';
    var url = "{{ path('admin.home.stats') }}";
    var jQplotData;
    var jQPlotInstance;
    var valueFormats;

    if ($datePicker) {
        // A month input's value is always ISO "YYYY-MM"; the browser localizes the display itself.
        $datePicker.value = moment().format('YYYY-MM');
    }

    jQuery(function ($) {
        if ($datePicker) {
            $datePicker.addEventListener('change', function () {
                if (!$datePicker.value) {
                    return;
                }
                var date = moment($datePicker.value, 'YYYY-MM');
                var month = date.month() + 1;
                var year = date.year();
                $('#statmois_label').html(date.format(displayDateFormat)).trigger('click');
                $('#statmois').load('{{ path('admin.home.month.sales.block', {month: 999999991, year: 999999992}) }}'.replace('999999991', month).replace('999999992', year));
                jQplotDate = date;
                statInputActive(true);
                retrieveJQPlotJson(jQplotDate, function () { statInputActive(false); }, 0);
            });
        }

        $('#span-calendar').click(function () {
            if (!$datePicker) {
                return;
            }
            if (typeof $datePicker.showPicker === 'function') {
                try { $datePicker.showPicker(); } catch (e) { $datePicker.focus(); }
            } else {
                $datePicker.focus();
            }
        });

        function statInputActive(type) {
            $('#date-picker').attr('readonly', type);
            $('.js-stats-refresh').attr('disabled', type);
        }

        var jQPlotsOptions = {
            animate: false,
            axesDefaults: { tickOptions: { showMark: true, showGridline: true } },
            axes: {
                xaxis: { borderColor: '#ccc', ticks: [], tickOptions: { showGridline: false } },
                yaxis: { min: 0, tickOptions: { showGridline: true, showMark: false, showLabel: true, shadow: false } }
            },
            seriesDefaults: { lineWidth: 3, shadow: false, markerOptions: { shadow: false, style: 'filledCircle', size: 12 } },
            grid: { background: '#FFF', shadow: false, borderColor: '#FFF' },
            highlighter: {
                show: true, sizeAdjust: 7, tooltipLocation: 'n',
                tooltipContentEditor: function (str, seriesIndex, pointIndex, plot) {
                    return $.jqplot.sprintf(valueFormats[seriesIndex], plot.data[seriesIndex][pointIndex][1]);
                }
            }
        };

        retrieveJQPlotJson(jQplotDate);

        $('[data-toggle="jqplot"]').click(function () {
            $(this).toggleClass('active');
            jsonSuccessLoad();
        });

        $('.js-stats-refresh').click(function () {
            statInputActive(true);
            retrieveJQPlotJson(jQplotDate, function () { statInputActive(false); }, 1);
        });

        function retrieveJQPlotJson(moment, callback, flush) {
            flush = flush || 0;
            $.getJSON(url, { month: moment.month() + 1, year: moment.year(), flush: flush })
                .done(function (data) { jQplotData = data; jsonSuccessLoad(); if (callback) callback(); })
                .fail(jsonFailLoad);
        }

        function initJqplotData(json) {
            var series = [], seriesColors = [];
            valueFormats = [];
            $('[data-toggle="jqplot"].active').each(function () {
                var position = $(this).index();
                var serie = json.series[position];
                series.push(serie.data);
                seriesColors.push(serie.color);
                valueFormats.push(serie.valueFormat);
            });
            var days = json.series[0].data.length;
            var ticks = [];
            for (var i = 1; i < days + 1; i++) { ticks.push([i - 1, i]); }
            jQPlotsOptions.axes.xaxis.ticks = ticks;
            jQPlotsOptions.title = json.title;
            jQPlotsOptions.seriesColors = seriesColors;
            return series;
        }

        function jsonFailLoad() {
            document.getElementById('jqplot').innerHTML =
                '<div class="alert alert-danger">{{ 'An error occurred while reading from JSON file'|trans({}, 'hookadminhome')|e('js') }}</div>';
        }

        function jsonSuccessLoad() {
            var series = initJqplotData(jQplotData);
            if (jQPlotInstance) { jQPlotInstance.destroy(); }
            jQPlotInstance = $.jqplot('jqplot', series, jQPlotsOptions);
            window.addEventListener('resize', function () { jQPlotInstance.replot({ resetAxes: true }); });
        }
    });
}());
</script>
